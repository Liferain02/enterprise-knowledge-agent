# 环境：development（基础配置）
APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
LOG_FORMAT=human
API_HOST=0.0.0.0
API_PORT=8000
LLM_PROVIDER=qwen
DASHSCOPE_MODEL=qwen3.5-flash
VISION_ENABLED=true
RETRIEVAL_TOP_K=5
PROJECT_KNOWLEDGE_RETRIEVAL_ENABLED=false
PROJECT_KNOWLEDGE_RETRIEVAL_TOP_K=2
HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5
CRAG_ENABLED=true
CRAG_MAX_RETRIES=1
CRAG_MAX_CONCURRENT=3
QUERY_EXPAND_ENABLED=true
QUERY_EXPAND_STRATEGY=rule_only
AUTH_ENABLED=false
USE_SQLITE_CHECKPOINTER=false
REDIS_HOST=disabled
CHROMA_PERSIST_DIRECTORY=./chroma_db_dev
MCP_SERVER_ENABLED=false
MEM0_ENABLED=false
