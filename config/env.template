# ===========================================
# 实验室科研智能助手 - 环境配置模板
# 复制为 config/.env 后填入实际值
# ===========================================

# ── LLM ──────────────────────────────────────
# 阿里千问（默认）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.5-flash

# OpenAI（二选一，注释上面改用这里）
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

LLM_PROVIDER=qwen   # qwen 或 openai

# Embedding 独立于对话 LLM。DeepSeek 等不提供 embeddings 时保持 qwen。
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v2

# ── 服务 ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8010
DEBUG=false

# ── 鉴权 ──────────────────────────────────────
# AUTH_ENABLED=true 时，应用会拒绝以下占位值并停止启动。
# 可用 `openssl rand -hex 32` 生成 JWT_SECRET_KEY。
AUTH_ENABLED=true
ADMIN_USERNAME=your-username
ADMIN_PASSWORD=your-password
JWT_SECRET_KEY=please-change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# ── 向量数据库 ────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ── RAG 检索 ──────────────────────────────────
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.7
CHUNK_SIZE=2000
CHUNK_OVERLAP=300
CHUNKING_STRATEGY=hybrid      # recursive / markdown / semantic / hybrid
CHUNK_TOKEN_SIZE=500
CHUNK_TOKEN_OVERLAP=100

# Reranker（默认 gte-rerank-v2，需 DASHSCOPE_API_KEY）
RERANKER_ENABLED=true
RERANKER_MODEL=gte-rerank-v2
RERANKER_PROVIDER=qwen        # qwen 或 baai（本地模型）
RERANKER_TOP_N=3
RERANKER_THRESHOLD=0.1

# 混合检索（BM25 + 向量）
HYBRID_SEARCH_ENABLED=true
HYBRID_VECTOR_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5

# CRAG 在当前消融中延迟高、召回下降且无答案判断波动，默认关闭；仅用于显式实验
CRAG_ENABLED=false

# 多轮追问仅在出现明确指代/省略信号时追加一条 Standalone 查询
STANDALONE_REWRITE_ENABLED=true
STANDALONE_REWRITE_MAX_CONTEXT_CHARS=120
QUERY_EXPAND_MAX_TOTAL_QUERIES=4

# ── Agent / 记忆 ──────────────────────────────
MAX_ITERATIONS=10
AGENT_TEMPERATURE=0.7
MAX_TOKEN_RESPONSE=2000

# 语义总结记忆：消息数超过阈值时自动压缩旧对话
SUMMARY_THRESHOLD=20     # 触发摘要的消息数阈值
SUMMARY_KEEP_RECENT=6    # 触发后保留的最近消息条数

# Blind Holdout 已达标：允许用户显式选择；normal 仍为默认且不自动路由
DEEP_RESEARCH_ENABLED=true

# ── Mem0 智能记忆 ────────────────────────────
MEM0_ENABLED=true        # 默认启用；初始化、检索或保存失败时自动降级，不阻塞问答
MEM0_MAX_CONTEXT_CHARS=500  # Mem0 记忆注入上下文的最大字符数

# LangGraph 状态持久化（推荐生产环境开启）
USE_SQLITE_CHECKPOINTER=true

# ── 会话 ──────────────────────────────────────
SESSION_EXPIRE_SECONDS=3600

# ── Rate Limiting ─────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_INGEST_PER_MINUTE=10

# ── MCP ───────────────────────────────────────
MCP_SERVER_ENABLED=true
MCP_SERVER_PORT=8001
MCP_INIT_TIMEOUT=30.0

# ── 代理（可选）──────────────────────────────
# HTTP_PROXY=http://127.0.0.1:7897
# HTTPS_PROXY=http://127.0.0.1:7897
