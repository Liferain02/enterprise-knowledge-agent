# 环境：staging（预发布配置）
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
AUTH_ENABLED=true
USE_SQLITE_CHECKPOINTER=true
REDIS_HOST=redis-staging
REDIS_PORT=6379
REDIS_DB=1
CHROMA_PERSIST_DIRECTORY=/data/chroma_staging
MCP_SERVER_ENABLED=true
MEM0_ENABLED=true
CRAG_MAX_RETRIES=2
CRAG_MAX_CONCURRENT=5
QUERY_EXPAND_STRATEGY=hybrid
# DASHSCOPE_API_KEY=your-key-here
# JWT_SECRET_KEY=your-random-string
# ADMIN_PASSWORD=staging-password
