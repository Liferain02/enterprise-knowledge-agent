# 环境：production（生产配置）
# 此文件覆盖 base.env 中的同名配置
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
AUTH_ENABLED=true
USE_SQLITE_CHECKPOINTER=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CHROMA_PERSIST_DIRECTORY=/data/chroma
MCP_SERVER_ENABLED=true
MEM0_ENABLED=true
CRAG_MAX_RETRIES=2
CRAG_MAX_CONCURRENT=5
QUERY_EXPAND_STRATEGY=hybrid
# 以下为敏感信息，必须在 .env（不在 git 中）或环境变量中配置：
# DASHSCOPE_API_KEY=your-key-here
# JWT_SECRET_KEY=your-32-char-random-string
# ADMIN_PASSWORD=change-me
