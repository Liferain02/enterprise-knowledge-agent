# ===========================================
# 企业知识库智能助手 - Git Ignore
# ===========================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg

# 虚拟环境
venv/
env/
.venv/
ENV/
conda_env/

# 环境变量（包含敏感信息）- 必须忽略！
.env
.env.local
.env.*.local

# 但跟踪 env.template 作为模板
!config/env.template

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 数据库文件（包含用户数据，禁止提交）
data/*.db
data/*.db-*

# 配置文件（包含敏感信息）
config/.env
config/*.env
!config/env.template

# Chroma 向量数据库
chroma_db/

# 日志
*.log
logs/

# 测试
.pytest_cache/
.coverage
htmlcov/

# Node.js MCP 服务器（保留 package.json 但忽略锁文件）
package-lock.json

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/package-lock.json

# 评估报告输出
scripts/reports/

# 临时文件
tmp/
temp/
*.tmp

node_modules/