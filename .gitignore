# ===========================================
# 企业知识库智能助手 - Git Ignore
# ===========================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/

# 虚拟环境
venv/
env/
.venv/
ENV/
conda_env/

# 环境变量（包含敏感信息）- 必须忽略！
.env
.env.*
!.env.example
!.env.template

# 但跟踪 env.template 作为模板
!config/env.template

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 数据库文件（包含用户数据，禁止提交）
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*

# 配置文件（包含敏感信息）
config/.env
config/*.env
!config/env.template

# Chroma 向量数据库
chroma_db/

# 本地知识原文（可能包含内部资料或有版权的论文）
data/knowledge/**
!data/knowledge/.gitkeep
!data/knowledge/dicts/
!data/knowledge/dicts/jieba_user_dict.txt

# 评测运行产物；可复现的数据集和脚本放在 tests/eval/
data/*.json
data/*.md

# 仅本地维护的设计、复盘和面试文档
docs/

# 日志
*.log
logs/

# 测试
.coverage
.coverage.*
coverage.xml
htmlcov/

# Node.js MCP 服务器（保留 package.json 但忽略锁文件）
package-lock.json

# 前端
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/package-lock.json

# 评估报告输出
scripts/reports/

# 临时文件
tmp/
temp/
*.tmp
*.bak
*.orig
.run/

node_modules/

# 本地 Agent / Codex 工作状态
.agents/
.codex
