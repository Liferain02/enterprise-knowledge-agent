# ===========================================
# 企业知识库智能助手 - Git Ignore
# ===========================================

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
eggs/
*.egg

# 虚拟环境
venv/
env/
.venv/
ENV/
conda_env/

# 环境变量（包含敏感信息）
.env
.env.local
.env.*.local

# IDE 配置
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Chroma 向量数据库
chroma_db/

# 日志
*.log
logs/

# 测试
.pytest_cache/
.coverage
htmlcov/

# Node.js (MCP 服务器)
node_modules/

# 临时文件
tmp/
temp/
*.tmp

